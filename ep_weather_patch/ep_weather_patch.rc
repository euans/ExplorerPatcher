#include <winres.h>
#include "resource.h"

IDR_EP_CLIENT RCDATA "payload\\ExplorerPatcher.amd64.dll"
IDR_EP_GUI    RCDATA "payload\\ep_gui.dll"
IDR_EP_HOST   RCDATA "payload\\ep_weather_host.dll"
IDR_EP_STUB   RCDATA "payload\\ep_weather_host_stub.dll"

#ifdef TEST_BUILD
1 RT_MANIFEST "manifest.asinvoker.xml"
#else
1 RT_MANIFEST "manifest.admin.xml"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ExplorerPatcher alternate weather providers - patcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ep_weather_patch.exe"
            VALUE "OriginalFilename", "ep_weather_patch.exe"
            VALUE "ProductName", "ExplorerPatcher alternate weather providers"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
